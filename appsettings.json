  "OrderQuery": {
    "CustomerOrderNumberField": "NumAtCard",
    "IntegrationIdField": "U_APIRef",
    "ProcessingStatusField": "U_ProcessingStatus",
    "OrderStatusField": "U_OrderStatus",
    "ConfirmedField": "Confirmed",
    "DefaultProcessingStatus": "UPDATED",
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "MaxServiceLayerRows": 5000
  },
  "OrderPosting": {
    "BusinessTimeZone": "Asia/Dubai",
    "CustomerOrderNumberField": "U_CustOrderNum",
    "OrderStatusField": "U_OrderStatus",
    "IntegrationIdField": "U_APIRef",
    "ApiUserField": "U_APIUser",
    "ProcessingStatusField": "U_ProcessingStatus",
    "AcceptedProcessingStatus": "ACCEPTED",
    "MissingLimitStatus": "OOR",
    "ShippingLeadDaysField": "U_ShipLeadDays",
    "ItemCostCenterField": "U_BIO_CostCenter",
    "LineCostCenterFields": [ "COGSCostingCode2" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeepLogging": {
    "Enabled": true,
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogSapPayload": true,
    "MaxBodyChars": 30000,
    "ExcludedPaths": [
      "/swagger",
      "/health"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/vaniperen-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*"
}